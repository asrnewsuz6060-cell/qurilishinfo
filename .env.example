# Bu faylni nusxalab ".env" nomi bilan saqlang, keyin qiymatlarni o'zgartiring.
# ".env" faylini hech qachon ochiq joyga (GitHub public repo va h.k.) yuklamang.

PORT=3000

# Sessiya uchun maxfiy kalit - uzun va tasodifiy qatorga almashtiring
SESSION_SECRET=bu-yerga-uzun-tasodifiy-satr-yozing

# Server birinchi marta ishga tushganda shu login/parol bilan admin yaratiladi.
# Keyin admin panelidagi "Parolni almashtirish" orqali darhol o'zgartiring.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=birinchi-parol-shart-almashtiriladi
